<?xml version="1.0" encoding="UTF-8"?>
<!-- Unicast (static initial peers) discovery to bypass container<->host
     multicast asymmetry. Container reaches the host cm_node directly. -->
<dds>
  <profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <participant profile_name="static_peers" is_default_profile="true">
      <rtps>
        <builtin>
          <initialPeersList>
            <locator><udpv4><address>127.0.0.1</address></udpv4></locator>
            <locator><udpv4><address>172.22.39.187</address></udpv4></locator>
          </initialPeersList>
        </builtin>
      </rtps>
    </participant>
  </profiles>
</dds>
